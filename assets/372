y across suppliers, manufacturing facilities, warehouses, and distribution centres enables better planning and uninterrupted production.<\/p>\r\n      <\/div>\r\n\r\n      <!-- Card 4 -->\r\n      <div class=\"wp-challenge-card\">\r\n        <div class=\"wp-card-icon\">\r\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"\/><polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"\/><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"\/><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"\/><\/svg>\r\n        <\/div>\r\n        <h3>Distribution Efficiency<\/h3>\r\n        <p>Supporting the efficient movement of vehicles, components, and spare parts across manufacturing facilities, dealerships, distributors, and service networks helps improve product availability and customer service.<\/p>\r\n      <\/div>\r\n\r\n      <!-- Card 5 -->\r\n      <div class=\"wp-challenge-card\">\r\n        <div class=\"wp-card-icon\">\r\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"\/><path d=\"M16 12l-4-4-4 4\"\/><\/svg>\r\n        <\/div>\r\n        <h3>Supply Chain Agility<\/h3>\r\n        <p>Responding quickly to changing production schedules, supplier requirements, and market demand requires flexible and scalable logistics operations.<\/p>\r\n      <\/div>\r\n\r\n    <\/div>\r\n  <\/div>\r\n\r\n  <!-- Pagination Dots -->\r\n  <div class=\"wp-carousel-dots\" id=\"wpCarouselDots\"><\/div>\r\n<\/div>\r\n\r\n<style>\r\n\/* Base Reset & Containment *\/\r\n.wp-carousel-wrapper,\r\n.wp-carousel-wrapper * {\r\n  box-sizing: border-box !important;\r\n}\r\n\r\n.wp-carousel-wrapper {\r\n  width: 100%;\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n  position: relative;\r\n  font-family: 'Manrope', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif !important;\r\n  padding: 10px 0;\r\n  overflow: hidden;\r\n}\r\n\r\n.wp-carousel-container {\r\n  width: 100%;\r\n  overflow-x: hidden;\r\n  padding: 10px 0;\r\n}\r\n\r\n.wp-carousel-track {\r\n  display: flex;\r\n  gap: 20px;\r\n  transition: transform 0.4s ease-in-out;\r\n}\r\n\r\n\/* Individual Slide Cards - 3 Visible at a Time *\/\r\n.wp-challenge-card {\r\n  flex: 0 0 calc((100% - 40px) \/ 3);\r\n  background-color: #ffffff;\r\n  border: 1px solid #e2e8f0;\r\n  border-left: 1px solid #e2e8f0;\r\n  border-radius: 12px;\r\n  padding: 28px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);\r\n  cursor: pointer;\r\n}\r\n\r\n\/* Hover Effect (Blue Left Line) *\/\r\n.wp-challenge-card:hover {\r\n  background-color: #f5f8ff;\r\n  border-color: #d0e1ff;\r\n  border-left: 5px solid #2563eb;\r\n  transform: translateY(-3px);\r\n  box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.08);\r\n}\r\n\r\n\/* Icon Styles *\/\r\n.wp-card-icon {\r\n  width: 44px;\r\n  height: 44px;\r\n  border-radius: 8px;\r\n  background-color: #2563eb;\r\n  color: #ffffff;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  margin-bottom: 20px;\r\n  flex-shrink: 0;\r\n}\r\n\r\n\/* Typography Overrides *\/\r\n.wp-challenge-card h3 {\r\n  font-family: 'Manrope', sans-serif !important;\r\n  font-size: 1.125rem !important;\r\n  font-weight: 700 !important;\r\n  color: #0f172a !important;\r\n  margin: 0 0 12px 0 !important;\r\n  line-height: 1.4 !important;\r\n}\r\n\r\n.wp-challenge-card p {\r\n  font-family: 'Manrope', sans-serif !important;\r\n  font-size: 0.925rem !important;\r\n  font-weight: 400 !important;\r\n  color: #475569 !important;\r\n  line-height: 1.6 !important;\r\n  margin: 0 !important;\r\n}\r\n\r\n\/* Dots Navigation *\/\r\n.wp-carousel-dots {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 8px;\r\n  margin-top: 20px;\r\n}\r\n\r\n.wp-dot {\r\n  width: 10px;\r\n  height: 10px;\r\n  border-radius: 50%;\r\n  background-color: #cbd5e1;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.wp-dot.active {\r\n  background-color: #2563eb;\r\n  width: 28px;\r\n  border-radius: 12px;\r\n}\r\n\r\n\/* Responsive Layout *\/\r\n@media (max-width: 900px) {\r\n  .wp-challenge-card {\r\n    flex: 0 0 calc((100% - 20px) \/ 2);\r\n  }\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .wp-challenge-card {\r\n    flex: 0 0 100%;\r\n  }\r\n}\r\n<\/style>\r\n\r\n<script>\r\n(function() {\r\n  function initInfiniteRotator() {\r\n    const track = document.getElementById('wpCarouselTrack');\r\n    const dotsContainer = document.getElementById('wpCarouselDots');\r\n    if (!track || !dotsContainer) return;\r\n\r\n    \/\/ Get initial cards\r\n    let cards = Array.from(track.children);\r\n    const totalCards = cards.length;\r\n    let activeDotIndex = 0;\r\n\r\n    \/\/ Create 5 Dots\r\n    dotsContainer.innerHTML = '';\r\n    for (let i = 0; i < totalCards; i++) {\r\n      const dot = document.createElement('div');\r\n      dot.classList.add('wp-dot');\r\n      if (i === 0) dot.classList.add('active');\r\n      dot.addEventListener('click', () => rotateToCard(i));\r\n      dotsContainer.appendChild(dot);\r\n    }\r\n\r\n    const dots = dotsContainer.querySelectorAll('.wp-dot');\r\n\r\n    function rotateToCard(targetIndex) {\r\n      if (targetIndex === activeDotIndex) return;\r\n\r\n      \/\/ Calculate how many steps forward we need to move\r\n      let steps = (targetIndex - activeDotIndex + totalCards) % totalCards;\r\n\r\n      const cardWidth = track.children[0].offsetWidth + 20;\r\n\r\n      \/\/ Smooth slide animation\r\n      track.style.transition = 'transform 0.4s ease-in-out';\r\n      track.style.transform = `translateX(-${steps * cardWidth}px)`;\r\n\r\n      \/\/ Update Dots UI\r\n      activeDotIndex = targetIndex;\r\n      dots.forEach((dot, idx) => {\r\n        dot.classList.toggle('active', idx === activeDotIndex);\r\n      });\r\n\r\n      \/\/ After slide completes, re-arrange DOM elements seamlessly\r\n      setTimeout(() => {\r\n        track.style.transition = 'none';\r\n        for (let i = 0; i < steps; i++) {\r\n          track.appendChild(track.firstElementChild); \/\/ Move front card to back\r\n        }\r\n        track.style.transform = 'translateX(0px)';\r\n      }, 400);\r\n    }\r\n\r\n    \/\/ Touch Swipe Support\r\n    let startX = 0;\r\n    track.addEventListener('touchstart', e => {\r\n      startX = e.touches[0].clientX;\r\n    });\r\n\r\n    track.addEventListener('touchend', e => {\r\n      const endX = e.changedTouches[0].clientX;\r\n      const diffX = startX - endX;\r\n\r\n      if (Math.abs(diffX) > 50) {\r\n        if (diffX > 0) {\r\n          \/\/ Swipe left -> Next Card\r\n          const nextIndex = (activeDotIndex + 1) % totalCards;\r\n          rotateToCard(nextIndex);\r\n        } else {\r\n          \/\/ Swipe right -> Previous Card\r\n          const prevIndex = (activeDotIndex - 1 + totalCards) % totalCards;\r\n          rotateToCard(prevIndex);\r\n        }\r\n      }\r\n    });\r\n  }\r\n\r\n  if (document.readyState === 'loading') {\r\n    document.addEventListener('DOMContentLoaded', initInfiniteRotator);\r\n  } else {\r\n    initInfiniteRotator();\r\n  }\r\n})();\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-e6519b2 e-flex e-con-boxed e-con e-parent\" data-id=\"e6519b2\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;gradient&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-9e72fb7 e-con-full e-flex e-con e-child\" data-id=\"9e72fb7\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-1eb5009 e-con-full e-flex e-con e-child\" data-id=\"1eb5009\